{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Designer",
  "version": "0.3.35",
  "identifier": "com.harnessdesigner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Harness Designer v0.3.35",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/default-parts-2d.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMkI2NzlFQzhDNjVCOUQKUldTZFc4YklubWNyRWNERGJ6bW00MjZsQTlwMzA1MnpNRWtEYTBQWEY5OGI5Rzc3bHR1MDQvbFYK",
      "endpoints": [
        "https://github.com/murse2000/HarnessDesigner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
